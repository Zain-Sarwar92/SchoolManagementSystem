PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/school_management
JWT_SECRET=change_this_to_a_long_random_secret_32chars_min
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
API_RATE_LIMIT=300

# Absolute path to PTS equation/diagram assets (required on clean prod deploys)
# Local default if unset: backend/public/pts-media
# Render free: /opt/render/project/src/public/pts-media
# PTS_MEDIA_ROOT=

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=use_a_long_unique_password

# --- Free live stack ---
# DB: MongoDB Atlas M0
# API: Render (this backend) — set CLIENT_URL to your Vercel URL
# UI: Vercel (frontend) — set VITE_API_URL=https://YOUR-API.onrender.com/api

# Optional — Gemini OCR for result sheet photo reading
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

